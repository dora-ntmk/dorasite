---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
	link: string;
	logo: ImageMetadata;
	title: string;
	description: string;
	color: string;
}

const { link, logo, title, description, color } = Astro.props;
---

<a href={link} target="_blank" style={`--btn-color: ${color}`} class="flex ring-1 ring-gray-200 rounded-md duration-200 [@media(hover:hover)_and_(pointer:fine)]:hover:bg-[var(--btn-color)]/5 [@media(hover:hover)_and_(pointer:fine)]:hover:ring-[var(--btn-color)]">
	<div class="logo flex items-center">
		<Image src={logo} alt="icon" class="ml-6 mr-4 min-w-8 max-w-8" />
	</div>
	<div class="description mr-3">
		 <h1 class="text-lg font-bold mt-2">{title}</h1>
		<p class="text-sm text-gray-500 mb-2.5">{description}</p>
	</div>
</a>