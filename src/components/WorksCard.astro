---
interface Props {
  imgSrc: string;
  title: string;
  date: string;
  url: string;
}

const { imgSrc, title, date, url } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer">
  <div class="flex flex-col rounded-md aspect-[7/4] ring-1 ring-gray-200 duration-200 [@media(hover:hover)_and_(pointer:fine)]:hover:bg-(--color-dorablue)/5 [@media(hover:hover)_and_(pointer:fine)]:hover:ring-(--color-dorablue)">
    <img src={imgSrc} alt={title} class="w-auto h-full object-cover rounded-sm mt-1 mx-1" />
    <span class="font-bold text-lg mx-1.5 my-0.5 line-clamp-2 min-h-[3.5rem]">{title}</span>
    <span class="text-gray-500 text-sm mx-1.5 mb-1.5">{date}</span>
  </div>
</a>
