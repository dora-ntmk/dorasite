---
import { createClient } from "microcms-js-sdk";
import WorksCard from "./WorksCard.astro";

const client = createClient({
  serviceDomain: "dorashark",
  apiKey: import.meta.env.SECRET_SHARK_API_KEY
});

type WorksThumbnail = {
  url: string;
  height: string;
  width: string;
}

// categoryがanyなのは今のところ何もデータを入れていないからなので、入れたら何型で帰ってくるかを確認して型指定してね、未来の僕。
type WorksContent = {
  id: string;
  createdAt: string;
  updatedAt: string;
  publishedAt: string;
  thumbnail: WorksThumbnail;
  title: string;
  date: string;
  category: any;
  url: string;
}

const res = await client.getAllContents<WorksContent>({
  endpoint: "works",
}).catch(() => [] as WorksContent[]);
---

<h2 class="text-2xl font-bold">わーくす</h2>
<p class="text-sm text-gray-500 mt-0.5 mb-3">Works</p>

<section class="grid grid-cols-2 min-[600px]:grid-cols-3 gap-3">
  {res.map(item => (
    <WorksCard
      imgSrc={item.thumbnail.url}
      title={item.title}
      date={new Date(item.date).toLocaleDateString("ja-JP", { timeZone: "Asia/Tokyo", year: "numeric", month: "2-digit", day: "2-digit" })}
      url={item.url}
    />
  ))}
</section>