---
import { Image } from "astro:assets";
import NavigationButton from "./NavigationButton.astro";

import doraIcon from "../logos/dora_icon.svg";
import homeIcon from "../icons/icon_home.svg";
import linkIcon from "../icons/icon_link.svg";
import businessIcon from "../icons/icon_business.svg";
import userIcon from "../icons/icon_user.svg";

const buttons = [
  { link: "/", icon: homeIcon, text: "ほーむ" },
  { link: "/", icon: linkIcon, text: "りんくとか" },
  { link: "/", icon: businessIcon, text: "わーくす" },
  { link: "/", icon: userIcon, text: "ぷろふぃーる" }
]
---

<nav class="sticky overflow-y-auto top-0 w-64 h-lvh py-3 mx-4 flex flex-col justify-between">
  <div>
    <section class="logo">
      <a href="/" class="inline-block rounded-lg duration-200 hover:bg-black/5">
        <Image src={doraIcon} alt="どら アイコン" class="w-14 h-auto m-3" /> 
      </a>
    </section>
    <section class="btn flex flex-col gap-1 w-full">
      {buttons.map(item => <NavigationButton {...item} />)}
    </section>
  </div>
  <div class="mx-1 mb-1">
    <p class="text-gray-500">&copy; 2026 どら</p>
  </div>
</nav>