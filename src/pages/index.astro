---
import Layout from "../layouts/Layout.astro";
import Profile from "../components/Profile.astro";
import SNSButton from "../components/SNSButton.astro";

import x_logo from "../logos/x-logo.svg";
import discord_logo from "../logos/discord-logo.svg";
import github_logo from "../logos/github-logo.svg";
import qiita_logo from "../logos/qiita-logo.svg";

const links = [
	{ link: "https://x.com/dora_natamoko", logo: x_logo, title: "@dora_natamoko", description: "日常と創作のツイートをぼちぼちやってます"},
	{ link: "https://discordapp.com/users/1305883677447684197", logo: discord_logo, title: "ntdmkmkmkmk8059", description: "基本的にこのDiscordに張り付いてます"},
	{ link: "https://github.com/dora-ntmk", logo: github_logo, title: "dora-ntmk", description: "あんまり草は生やせてません"},
	{ link: "https://qiita.com/dora-ntmk", logo: qiita_logo, title: "@dora-ntmk", description: "たまーに書きます"}
]
---

<Layout title="ホーム｜どらさいと">
	<Profile />
	<section class="links flex flex-col gap-y-2 my-3">
		{links.map(item => <SNSButton {...item} />)}
	</section>
</Layout>
